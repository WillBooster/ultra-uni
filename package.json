{
  "name": "ultra-uni",
  "version": "0.0.0-semantically-released",
  "description": "All-in-one metrics, linter, and formatter for multiple languages, built for WebAssembly and Cloudflare Workers.",
  "keywords": [
    "cloudflare-workers",
    "formatter",
    "linter",
    "metrics",
    "tree-sitter",
    "wasm"
  ],
  "license": "Apache-2.0",
  "author": "WillBooster Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/ultra-uni.git"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/buildWasm.mjs",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.3",
    "@willbooster/oxlint-config": "1.4.9",
    "@willbooster/wb": "22.29.3",
    "lefthook": "2.2.2",
    "miniflare": "4.20260730.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "vitest": "4.1.9"
  }
}
